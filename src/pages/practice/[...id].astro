---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI, otherLocale, type Locale } from '../../lib/i18n';

export async function getStaticPaths() {
  const items = await getCollection('practice');
  return items.map((p) => ({ params: { id: p.id }, props: { id: p.id } }));
}

const { id } = Astro.props;
const entry = await getEntry('practice', id);
if (!entry) return Astro.redirect('/404');

const locale = entry.data.lang as Locale;
const ui = UI[locale];
const d = entry.data;
const { Content } = await render(entry);

const slug = id.split('/').slice(1).join('/');
const altUrl = `/practice/${otherLocale(locale)}/${slug}/`;
const listHref = locale === 'zh' ? '/practice/' : '/en/practice/';
---
<BaseLayout
  title={`${d.title} · Jason`}
  description={d.summary}
  locale={locale}
  pathname={Astro.url.pathname}
>
  <article class="post reveal">
    <a class="back" href={listHref}>← {ui.nav.practice}</a>
    <h1 class="post-title">{d.title}</h1>
    <p class="post-meta">
      {d.project_category}{d.work_type ? ' · ' + d.work_type : ''}{d.tags.length > 0 ? ' · ' + d.tags.join(' / ') : ''}
    </p>
    <div class="prose">
      <Content />
    </div>
    <a class="lang-switch-inline" href={altUrl}>{ui.switchTo} →</a>
  </article>
</BaseLayout>

<script type="module" is:inline>
  // Mermaid 运行时渲染。
  // 排版理念参考 beautiful-mermaid（清晰优先、充足留白、统一字体），
  // 但站点为 Apple 浅色风，故采用 light-adapted 调色板而非 tokyo-night 暗色。
  (async () => {
    const els = document.querySelectorAll('.mermaid');
    if (!els.length) return;
    const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')).default;
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      flowchart: { nodeSpacing: 60, layerSpacing: 72, curve: 'basis', htmlLabels: true, padding: 18 },
      themeVariables: {
        fontFamily: '-apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", Roboto, sans-serif',
        fontSize: '15px',
        background: '#ffffff',
        primaryColor: '#eef4fd',
        primaryTextColor: '#1d1d1f',
        primaryBorderColor: '#0071e3',
        lineColor: '#86868b',
        secondaryColor: '#f5f5f7',
        tertiaryColor: '#d2d2d7',
        mainBkg: '#eef4fd',
        nodeBorder: '#0071e3',
        clusterBkg: '#f5f5f7',
        clusterBorder: '#d2d2d7',
        edgeLabelBackground: '#ffffff',
      },
    });
    await mermaid.run({ nodes: Array.from(els) });
  })();
</script>
