---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI, otherLocale, type Locale } from '../../lib/i18n';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({
    params: { id: a.id },
    props: { id: a.id },
  }));
}

const { id } = Astro.props;
const entry = await getEntry('articles', id);
if (!entry) return Astro.redirect('/404');

const locale = entry.data.lang as Locale;
const ui = UI[locale];
const d = entry.data;
const { Content } = await render(entry);

const dateStr = d.date.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 文章详情的语言切换：替换路径内嵌的语言段
const slug = id.split('/').slice(1).join('/');
const altUrl = `/articles/${otherLocale(locale)}/${slug}`;
const listHref = locale === 'zh' ? '/articles' : '/en/articles';
---

<BaseLayout
  title={`${d.title} · Jason`}
  description={d.summary}
  locale={locale}
  pathname={Astro.url.pathname}
>
  <article class="post reveal">
    <a class="back" href={listHref}>← {ui.nav.articles}</a>
    <h1 class="post-title">{d.title}</h1>
    <p class="post-meta">
      {dateStr}{d.tags.length > 0 ? ' · ' + d.tags.join(' / ') : ''}
    </p>
    {
      d.cover && (
        <img class="post-cover" src={d.cover} alt={d.title} />
      )
    }
    <div class="prose">
      <Content />
    </div>
    <a class="lang-switch-inline" href={altUrl}>{ui.switchTo} →</a>
  </article>
</BaseLayout>
