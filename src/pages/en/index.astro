---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { UI } from '../../lib/i18n';

const locale = 'en';
const ui = UI[locale];

const about = await getEntry('about', locale);
const d = about!.data;

const projects = (await getCollection('projects'))
  .filter((p) => p.data.lang === locale && p.data.featured && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const articles = (await getCollection('articles'))
  .filter((a) => a.data.lang === locale && !a.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title={`${d.name} · ${d.role}`}
  description={d.tagline}
  locale={locale}
  pathname={Astro.url.pathname}
>
  <section class="hero reveal" id="top">
    <p class="eyebrow">{d.role}</p>
    <h1 class="hero-title">{d.name}</h1>
    <p class="hero-tagline">{d.tagline}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/en/portfolio/">{ui.nav.portfolio} →</a>
      <a class="btn btn-ghost" href="/en/articles/">{ui.nav.articles}</a>
    </div>
  </section>

  <section class="section reveal">
    <h2 class="section-title">{ui.aboutTitle}</h2>
    <div class="prose" style="max-width:720px;margin-top:18px">
      <p>{d.bio}</p>
    </div>
    {
      d.skills.length > 0 && (
        <div class="tags" style="margin-top:20px">
          {d.skills.map((s) => (
            <span class="tag">{s}</span>
          ))}
        </div>
      )
    }
  </section>

  {
    projects.length > 0 && (
      <section class="section reveal">
        <div class="section-head">
          <h2 class="section-title">{ui.featured}</h2>
          <a class="link-more" href="/en/portfolio/">{ui.viewAll} →</a>
        </div>
        <div class="grid">
          {projects.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )
  }

  {
    articles.length > 0 && (
      <section class="section reveal">
        <div class="section-head">
          <h2 class="section-title">{ui.recent}</h2>
          <a class="link-more" href="/en/articles/">{ui.viewAll} →</a>
        </div>
        <div class="grid">
          {articles.map((a) => (
            <ArticleCard article={a} locale={locale} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
